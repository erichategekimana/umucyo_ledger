# Umucyo Ledger — Example Environment Configuration (.env.example)
# Copy this file to .env and adjust values for your local environment.

DJANGO_ENV=development
DJANGO_SECRET_KEY=your-secret-key-change-in-production
DJANGO_DEBUG=True
ALLOWED_HOSTS=*

# PostgreSQL 16 Database Configuration (SRS Section 2.4 requirement)
DB_NAME=umucyo_ledger
DB_USER=umucyo
DB_PASSWORD=umucyo
DB_HOST=localhost
DB_PORT=5432

# Redis & Background Tasks (Placeholders for Celery integration)
REDIS_URL=redis://localhost:6379/0

# External Gateways (Placeholders for Africa's Talking / SMPP SMS & USSD API)
AFRICAS_TALKING_USERNAME=placeholder_username
AFRICAS_TALKING_API_KEY=placeholder_api_key_for_africas_talking
